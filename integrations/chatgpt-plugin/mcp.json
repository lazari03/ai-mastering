{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "auralith-forge": {
      "type": "streamable-http",
      "url": "https://auralithforge.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "registrationUrl": "https://api.auralithforge.app/register",
            "resource": "https://auralithforge.app/mcp",
            "defaultScopes": ["mastering:read", "mastering:write"]
          }
        }
      }
    }
  }
}
