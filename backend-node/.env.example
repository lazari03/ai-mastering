NODE_ENV=production
PORT=8000
# Restrict this to your real frontend origin in production — the server
# refuses a wildcard here silently, it just warns loudly on startup.
CORS_ORIGINS=*
PYTHON_API_BASE_URL=http://localhost:8001
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_UPLOAD_MB=200
# Must be exactly this in production — anything else falls back to a much
# cruder engine, and the server now refuses to start rather than do that
# silently. See server.js.
MASTERING_ENGINE=adaptive_python

# Shared secret for the admin-only built-in preset management routes
# (PUT/DELETE /admin/presets/:slug) — unset disables those routes (501).
# Generate one with: openssl rand -hex 32
ADMIN_API_KEY=

# Firebase Admin — verifies the ID token every request must carry. See
# FIREBASE_SETUP.md. Use exactly one of these two.
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Polar (Merchant of Record) — the paywall. See PRICING.md for the plan
# and POLAR_SETUP.md for how to create each product. Leaving any of the
# five product IDs unset keeps that specific item ungated (no paywall)
# rather than breaking the feature entirely — fine for local dev, not for
# production.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# "sandbox" until you've tested a real end-to-end purchase against Polar's
# sandbox environment — switch to "production" only then.
POLAR_ENVIRONMENT=sandbox

POLAR_SUBSCRIPTION_PRODUCT_ID=        # $19/mo All-Access, recurring
POLAR_MASTER_STANDARD_PRODUCT_ID=     # $2.99, one-time
POLAR_MASTER_PROFESSIONAL_PRODUCT_ID= # $4.99, one-time
POLAR_CHORDS_PRODUCT_ID=              # $1.49, one-time
POLAR_STEM_ADDON_PRODUCT_ID=          # $1.99, one-time

# Telegram admin bot — pushes a message on every new signup and every new
# purchase (one-time or subscription), and answers /pageviews and /stats
# commands on demand. See services/telegramService.js. Leaving either unset
# disables the whole feature silently (no notifications, bot doesn't
# respond to anything).
#
# TELEGRAM_BOT_TOKEN — message @BotFather on Telegram, /newbot, follow the
#   prompts; it hands you a token like "123456:ABC-DEF...".
# TELEGRAM_CHAT_ID — the numeric id of the ONE chat that gets notified and
#   is allowed to run commands (the bot ignores everyone else). Message
#   @userinfobot from the account you want notified — it replies with your
#   numeric id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GA4 Data API — backs the bot's /pageviews and /stats commands with real
# traffic numbers (screenPageViews, sessions, activeUsers). Read-only,
# optional: leave GA4_PROPERTY_ID unset and those two commands just report
# "GA4 not configured" instead of failing.
#
# GA4_PROPERTY_ID — GA4 Admin > Property Settings > Property ID (a number,
#   not the "G-XXXXXXXXXX" measurement ID used by NEXT_PUBLIC_GA_MEASUREMENT_ID).
# Service account — needs Viewer access added explicitly in GA4 Admin >
#   Property Access Management (the Firebase project's own default service
#   account does NOT have this by default; create a separate one in Google
#   Cloud Console > IAM > Service Accounts, download its JSON key, then add
#   its email as a Viewer in GA4). Use exactly one of these two, same
#   inline-JSON-vs-file-path pattern as Firebase Admin above.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_PATH=/absolute/path/to/ga4-service-account.json
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
