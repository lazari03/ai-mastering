# --- OS junk ---
.DS_Store

# --- Local Claude Code session/tooling state, not project source ---
.claude/

# --- Secrets / local env --- (.env.example files are templates, kept)
.env
.env.local
.env.*.local

# --- Python ---
__pycache__/
*.pyc
backend/venv312/
backend/venv/

# --- Node ---
node_modules/
frontend/.next/

# --- Generated audio: uploads, renders, analysis reports ---
# These are user input files and mastering output — large, per-run, and
# not something anyone else needs from git history. Applies at every level
# since both backend-node/ and the repo root have their own uploads/outputs.
uploads/
outputs/
backend/validation_report.json

# Graphify generated analysis artifacts
graphify-out/

# Local progress notes
progress.md

# --- Docs & Firestore rules, kept local-only ---
# *.md was already tracking 7 files (ARCHITECTURE.md, DEPLOYMENT.md,
# FIREBASE_SETUP.md, MASTERING_ENGINE.md, POLAR_SETUP.md, PRICING.md,
# README.md) before this — this pattern only stops NEW changes to those
# and any new .md file from being staged going forward; it does not
# retroactively untrack them. Run `git rm --cached <file>` per file (see
# below) if you actually want them removed from git's index too.
*.md
firestore.rules
