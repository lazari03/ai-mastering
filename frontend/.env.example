NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Used by sitemap.xml, robots.txt, and canonical/OG URLs — update once you
# own a real domain, see src/lib/seo.js.
NEXT_PUBLIC_SITE_URL=https://auralithforge.app

# Firebase web config — see FIREBASE_SETUP.md. Safe to expose client-side,
# that's what these are for (they identify the project, not grant access).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Analytics — see components/Analytics.jsx. Gated behind cookie consent
# (CookieBanner.jsx) and NEXT_PUBLIC_* vars are baked into the JS bundle at
# BUILD time, not read at runtime — changing this on the VPS's .env
# requires a rebuild (`docker compose up -d --build`), a restart alone
# won't pick it up. Leaving it unset silently ships with no traffic
# analytics at all; next.config.mjs warns loudly at build time if that
# looks unintentional. (Google Analytics/gtag support was removed
# entirely — Plausible is the only traffic-analytics provider now.)
#
# Plausible — cookieless, set to your site's domain as registered there.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Ad conversion pixels — separate from Plausible above (that measures
# traffic; these let Meta/TikTok optimize and attribute ad spend). Same
# cookie-consent gate, same build-time-baked caveat. Get each ID from
# Meta Events Manager / TikTok Events Manager after creating a pixel
# there. sign_up, begin_checkout, and purchase (lib/analytics.js) fire to
# both automatically once the ID is set — no per-event wiring needed.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
